# Android waitlist — a SEPARATE Supabase project from the app's, so this key
# cannot reach user data. Use the project's anon (publishable) key, never the
# service role key: the waitlist table's RLS policy allows insert only.
#
# Supabase dashboard -> the waitlist project -> Project Settings -> API
WAITLIST_SUPABASE_URL=https://your-waitlist-project.supabase.co
WAITLIST_SUPABASE_ANON_KEY=
